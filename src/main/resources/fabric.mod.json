{
	"schemaVersion": 1,
	"id": "plutonium",
	"version": "${version}",
	"name": "Plutonium",
	"description": "A simple config library for Pluto's mods.  You shouldn't have to download this separately",
	"authors": [
		"Pluto7073"
	],
	"contact": {
		"homepage": "https://github.com/pluto7073/Plutonium-Config",
		"sources": "https://github.com/pluto7073/Plutonium-Config"
	},
	"license": "MIT",
	"icon": "assets/plutonium/icon.png",
	"environment": "*",
	"accessWidener": "plutonium.accesswidener",
	"entrypoints": {
		"main": [
			"ml.pluto7073.plutonium.PlutoniumConfig"
		],
		"client": [
			"ml.pluto7073.plutonium.client.PlutoniumClient"
		]
	},
	"mixins": [],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=17",
		"fabric-api": ">=${fabric_api_version}"
	},
	"custom": {
		"modmenu": {
			"badges": [ "library" ],
			"update_checker": false
		}
	}
}